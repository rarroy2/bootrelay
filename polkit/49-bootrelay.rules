//
// Allow members of the "wheel" group to run the BootRelay helper as root
// without a password prompt, but ONLY the bootrelay program. The helper itself
// validates its arguments and does not execute arbitrary commands.
//
// Manual installer: /etc/polkit-1/rules.d/49-bootrelay.rules
// RPM package:      /usr/share/polkit-1/rules.d/49-bootrelay.rules
// Owner: root:root, mode 0644.

polkit.addRule(function (action, subject) {
    if (action.id !== 'org.freedesktop.policykit.exec')
        return null;

    var program = action.lookup('program');
    if (program !== '/usr/bin/bootrelay' &&
        program !== '/usr/local/bin/bootrelay' &&
        program !== '/usr/bin/boot-to-windows' &&
        program !== '/usr/local/bin/boot-to-windows')
        return null;

    if (!subject.local || !subject.active)
        return null;

    if (!subject.isInGroup('wheel'))
        return null;

    return polkit.Result.YES;
});
